programa {
  funcao inicio() {
    cadeia nome
    real ano1, ano2, subtracao
    escreva("nome do usuario: ")
    leia(nome)
    escreva("ano atual: ")
    leia(ano1)
    escreva("ano de mascimento: ")
    leia(ano2)
    subtracao= ano1 - ano2
    escreva("a idade que voce ira completar esse ano e igual a ", subtracao)
  }
}
