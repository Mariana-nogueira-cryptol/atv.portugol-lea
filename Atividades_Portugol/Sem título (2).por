programa {
  funcao inicio() {
    cadeia aluno
    real n1,n2,n3,media
    escreva("adicione o nome do aluno: ")
    leia(aluno)
    escreva("nota 1: ")
    leia(n1)
    escreva("nota 2: ")
    leia(n2)
    escreva("nota 3: ")
    leia(n3)
    media = n1 + n2 + n3 / 3
    escreva("a media do aluno foi: ",media) 



  }
}
