programa {
  funcao inicio() {
      inteiro a,b,subtracao,multiplicacao,divisao
      escreva("digite primeiro valor")
      leia(a)
      escreva("digite segundo valor")
      leia(b)
      subtracao = a - b
      multiplicacao = a * b
      divisao = a / b
      escreva("a subtracao do valor",a,"-",b," e igual a", subtracao,"\n")
      escreva("a multiplicacao do valor",a,"*",b,"e igual",multiplicacao,"\n")
      escreva("a divisao do valor",a,"/",b,"e igual", divisao,"\n")
  }
}
